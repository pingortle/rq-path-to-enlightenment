<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">New challenge</h1>

  <%= render "form", challenge: @challenge, journey: @journey %>

  <h2 class="text-2xl font-bold mt-6 mb-4">Associated MinitestTestClass</h2>
  <%= render 'minitest_test_classes/form', minitest_test_class: @challenge.challengeable %>

  <%= link_to "Back to journey", @challenge.journey, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
</div>
