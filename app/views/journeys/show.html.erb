<div class="mx-auto md:w-2/3 w-full">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @journey %>

    <h2 class="text-2xl font-bold mt-6 mb-4">Challenges</h2>
    <% if @journey.challenges.any? %>
      <ul class="list-disc pl-5">
        <% @journey.challenges.order(:position).each do |challenge| %>
          <li class="mb-2">
            <%= link_to challenge.title, journey_challenge_path(@journey, challenge), class: "text-blue-600 hover:text-blue-800" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No challenges yet.</p>
    <% end %>

    <%= link_to "Add new challenge", new_journey_challenge_path(@journey), class: "mt-4 rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium" %>

    <div class="mt-6">
      <%= link_to "Edit this journey", edit_journey_path(@journey), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <%= link_to "Back to journeys", journeys_path, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <div class="inline-block ml-2">
        <%= button_to "Destroy this journey", @journey, method: :delete, class: "rounded-lg py-3 px-5 bg-gray-100 font-medium", form: { data: { turbo_confirm: "Are you sure you want to delete this journey?" } } %>
      </div>
    </div>
  </div>
</div>
