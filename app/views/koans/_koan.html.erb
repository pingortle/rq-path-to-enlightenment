<div data-controller="minitest" id="<%= dom_id koan %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= koan.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= koan.description %>
  </p>

  <%= render "shared/code_runner", initial_code: koan.initial_code %>

  <p class="my-5">
    <strong class="block font-medium mb-1">Order:</strong>
    <%= koan.order %>
  </p>
</div>
